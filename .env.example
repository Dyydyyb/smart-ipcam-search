# ==============================================================================
# CONFIGURACIÓN DE CÁMARA IP (IMOU / DAHUA)
# ==============================================================================
# La IP local de la cámara (ej: 192.168.1.150)
CAMERA_IP=192.168.1.150
CAMERA_PORT=554
CAMERA_USER=admin

# IMPORTANTE: En cámaras Imou la contraseña suele ser el SAFETY CODE impreso
# en la etiqueta inferior de la cámara (6-8 caracteres alfanuméricos)
CAMERA_PASSWORD=TU_SAFETY_CODE_AQUI

# Canales de transmisión
# Subtype 0 = Mainstream (Alta resolución / Grabación)
# Subtype 1 = Substream (Baja resolución / Detección AI)
CAMERA_RTSP_MAIN=rtsp://${CAMERA_USER}:${CAMERA_PASSWORD}@${CAMERA_IP}:${CAMERA_PORT}/cam/realmonitor?channel=1&subtype=0
CAMERA_RTSP_SUB=rtsp://${CAMERA_USER}:${CAMERA_PASSWORD}@${CAMERA_IP}:${CAMERA_PORT}/cam/realmonitor?channel=1&subtype=1

# ==============================================================================
# BASE DE DATOS (POSTGRESQL)
# ==============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_cam_db
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ==============================================================================
# MOTOR LLM LOCAL (OLLAMA)
# ==============================================================================
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ==============================================================================
# CONFIGURACIÓN DEL PIPELINE DE VISIÓN
# ==============================================================================
YOLO_MODEL_NAME=yolo11n.pt
DETECTION_FPS=5
CONFIDENCE_THRESHOLD=0.45
STORAGE_PATH=./storage
