# ===================================================================
# BADDGROUP VISION AI - CONFIGURACIÓN DE PRODUCCIÓN Y DISTRIBUCIÓN
# ===================================================================

# 1. CÁMARA PRINCIPAL (RTSP)
CAMERA_IP=192.168.100.209
CAMERA_PORT=554
CAMERA_USER=admin
CAMERA_PASSWORD=
CAMERA_RTSP_SUB=rtsp://admin:@192.168.100.209:554/cam/realmonitor?channel=1&subtype=1
CAMERA_RTSP_MAIN=rtsp://admin:@192.168.100.209:554/cam/realmonitor?channel=1&subtype=0

# 2. MOTOR DE INTELIGENCIA ARTIFICIAL EN PRODUCCIÓN
# Clave de API de Google AI Studio (Gratis: 15 RPM / 1 millón tokens/min)
# Obtén tu clave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 3. MOTOR LOCAL DE FALLBACK (Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# 4. PARÁMETROS DE DETECCIÓN Y GRABACIÓN CONTINUA
DETECTION_FPS=5
CONFIDENCE_THRESHOLD=0.45
IOU_THRESHOLD=0.5
BUFFER_SECONDS=3.0
MAX_EVENT_DURATION=60.0
INACTIVITY_TIMEOUT=3.0
SAVE_FULL_RES_CLIPS=true
ENABLE_GPU_ACCELERATION=true
